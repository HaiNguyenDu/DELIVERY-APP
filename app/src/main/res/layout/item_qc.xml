<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/size_10"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/qc_1"
        android:clipToOutline="true"
        android:background="@drawable/bg_corner"
        android:layout_width="@dimen/size_300"
        android:scaleType="centerCrop"
        android:layout_height="@dimen/size_150"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/font_14"
        app:layout_constraintTop_toBottomOf="@+id/img"
        android:layout_marginTop="@dimen/size_10"
        app:layout_constraintStart_toStartOf="@+id/img"
        app:layout_constraintEnd_toEndOf="@+id/img"
        android:paddingEnd="20dp"
        android:text="Tỏa sức sáng tạo, bùng khí chất"
        android:fontFamily="@font/bold"
        android:textColor="@color/black"
        />
    <TextView
        android:id="@+id/tv_qc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/font_10"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/img"
        android:text="QC"
        android:fontFamily="@font/bold"
        android:textColor="@color/grey"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/point"
        android:layout_width="@dimen/_2dp"
        android:backgroundTint="@color/grey"
        android:layout_height="@dimen/_2dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/tv_qc"
        app:layout_constraintBottom_toBottomOf="@+id/tv_qc"
        android:layout_marginStart="@dimen/size_5"
        app:cardCornerRadius="@dimen/size_6"/>
    <TextView
        android:id="@+id/tv_branch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/font_10"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/point"
        android:layout_marginStart="5dp"
        android:text="Lamboghini"
        android:fontFamily="@font/bold"
        android:textColor="@color/grey"
        />
</androidx.constraintlayout.widget.ConstraintLayout>