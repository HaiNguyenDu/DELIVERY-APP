<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_bar_home"
    android:paddingHorizontal="@dimen/size_12"
    android:paddingTop="@dimen/size_16">

    <ImageView
        android:id="@+id/ivActiveState"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:contentDescription="@null"
        android:src="@drawable/ic_locate_fixed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_6"
        android:fontFamily="@font/medium"
        android:text="@string/t_ng_c_h_i_nh_n_cu_c_khi_b_t_t_ng_nh_n_cu_c"
        app:layout_constraintBottom_toBottomOf="@id/ivActiveState"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivActiveState"
        app:layout_constraintTop_toTopOf="@id/ivActiveState" />

    <View
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:layout_marginTop="@dimen/size_16"
        android:background="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/ivActiveState" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swAutomaticallyTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="@string/automatically_receive_trip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emptyView"
        app:thumbTint="@color/green"
        app:trackTint="@color/bg_color" />

    <View
        android:id="@+id/emptyView1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:background="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/swAutomaticallyTrip" />

    <LinearLayout
        android:id="@+id/llPower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/size_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emptyView1">

        <ImageView
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:contentDescription="@null"
            android:src="@drawable/ic_power"
            app:tint="@color/red" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_6"
            android:layout_weight="1"
            android:fontFamily="@font/medium"
            android:text="@string/turn_off_power"
            android:textColor="@color/red" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
