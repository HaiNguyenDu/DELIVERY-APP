<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".driver.driver_income.DriverIncomeActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_home"
        android:paddingStart="@dimen/size_12"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar_home"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/size_22"
        android:paddingVertical="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/size_12"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivIncome"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:contentDescription="@null"
                android:src="@drawable/ic_income"
                app:tint="@color/green" />

            <TextView
                android:id="@+id/tvIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/income"
                android:textColor="@color/green" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llBonus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/size_12"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivBonus"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:contentDescription="@null"
                android:src="@drawable/ic_gem" />

            <TextView
                android:id="@+id/tvBonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/bonus" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llWallet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/size_12"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ivWallet"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:contentDescription="@null"
                android:src="@drawable/ic_wallet" />

            <TextView
                android:id="@+id/tvWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/wallet" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
