<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <Toolbar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:navigationIcon="@drawable/ic_back"
        android:title="@string/detail_package"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_btn_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_20"
                android:layout_marginTop="16dp"
                android:text="@string/description_detail_package"
                android:textColor="@color/grey_500"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_delivery"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_180"
                android:layout_marginTop="16dp"
                android:src="@drawable/img_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

            <TextView
                android:id="@+id/tv_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="16dp"
                android:text="Kích cỡ *"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_delivery" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@id/tv_size_label"
                app:layout_constraintTop_toBottomOf="@id/tv_size_label"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_s"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="0dp"
                    android:checked="true"
                    android:fontFamily="@font/bold"
                    android:text="S"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="@dimen/font_12"
                    app:chipBackgroundColor="@color/chip_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_m"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:checked="true"
                    android:fontFamily="@font/bold"
                    android:text="M"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="@dimen/font_12"
                    app:chipBackgroundColor="@color/chip_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_l"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:checked="true"
                    android:fontFamily="@font/bold"
                    android:text="L"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="@dimen/font_12"
                    app:chipBackgroundColor="@color/chip_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_xl"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:checked="true"
                    android:fontFamily="@font/bold"
                    android:padding="0dp"
                    android:text="XL"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="@dimen/font_12"
                    app:chipBackgroundColor="@color/chip_selector" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tv_weight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_5"
                android:layout_marginEnd="@dimen/size_20"
                android:text="Trọng lượng *"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/chip_group_size"
                app:layout_constraintTop_toTopOf="@id/tv_size_label" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_weight"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_edit_rounded"
                android:inputType="numberDecimal"
                android:padding="@dimen/size_5"
                android:textAlignment="center"
                android:textSize="@dimen/font_14"
                app:layout_constraintBottom_toBottomOf="@+id/chip_group_size"
                app:layout_constraintStart_toStartOf="@+id/tv_weight_label"
                app:layout_constraintTop_toTopOf="@id/chip_group_size" />

            <TextView
                android:id="@+id/tv_kg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/bold"
                android:text="kg"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@id/edt_weight"
                app:layout_constraintStart_toEndOf="@id/edt_weight"
                app:layout_constraintTop_toTopOf="@id/edt_weight" />

            <TextView
                android:id="@+id/tv_error_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/medium"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="@id/edt_weight"
                app:layout_constraintTop_toBottomOf="@id/edt_weight" />

            <FrameLayout
                android:id="@+id/layout_add_photo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashed_border"
                android:paddingStart="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_error_weight">

                <TextView
                    android:id="@+id/tv_add_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/medium"
                    android:gravity="center_vertical"
                    android:text="@string/add_image"
                    android:textColor="@color/grey_500"
                    app:drawableStartCompat="@drawable/ic_camera" />

                <LinearLayout
                    android:id="@+id/layout_add_photo_success"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_edit_rounded"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tv_add_photo_success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/size_20"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/medium"
                        android:gravity="center_vertical"
                        android:text="Đã thêm ảnh"
                        android:textColor="@color/grey_500" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_delete"
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/size_20"
                    android:src="@drawable/ic_trash"
                    android:visibility="gone"
                    app:tint="@color/grey" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_goods_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="16dp"
                android:text="@string/package_type"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_add_photo" />

            <TextView
                android:id="@+id/tv_prohibited_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_20"
                android:fontFamily="@font/bold"
                android:text="@string/mat_hang_nao_bi_cam"
                android:textColor="@color/main_blue"
                app:layout_constraintBottom_toBottomOf="@id/tv_goods_type_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_goods_type_label" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/size_20"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_goods_type_label">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_goods_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_goods_type_label"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_clothing"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:checked="true"
                        android:fontFamily="@font/bold"
                        android:text="@string/clothes"
                        android:textAlignment="center"
                        android:textSize="@dimen/font_14"
                        app:chipBackgroundColor="@color/chip_selector"
                        app:chipIcon="@drawable/ic_clothing" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_electronics"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:checked="true"
                        android:fontFamily="@font/bold"
                        android:text="@string/equipment"
                        android:textAlignment="center"
                        android:textColor="@color/chip_text_selector"
                        android:textSize="@dimen/font_14"
                        app:chipBackgroundColor="@color/chip_selector" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_fragile"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:checked="true"
                        android:fontFamily="@font/bold"
                        android:text="@string/fragile"
                        android:textAlignment="center"
                        android:textColor="@color/chip_text_selector"
                        android:textSize="@dimen/font_14"
                        app:chipBackgroundColor="@color/chip_selector" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_other"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:checked="true"
                        android:fontFamily="@font/bold"
                        android:text="@string/other"
                        android:textAlignment="center"
                        android:textColor="@color/chip_text_selector"
                        android:textSize="@dimen/font_14"
                        app:chipBackgroundColor="@color/chip_selector" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_corner_white_medium"
        android:elevation="@dimen/size_8"
        android:paddingVertical="@dimen/size_20"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_50"
            android:layout_marginHorizontal="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_10"
            android:background="@drawable/bg_button_green_medium_corner"
            android:elevation="@dimen/size_4"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Xác nhận"
                android:textColor="@color/white"
                android:textSize="@dimen/font_18"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

