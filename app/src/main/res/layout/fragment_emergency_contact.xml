<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        tools:context=".driver.register.identification.IdentificationCardFragment">

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_150"
        android:background="@color/green"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_24"
        android:fontFamily="@font/bold"
        android:text="@string/emergency_contact_and_address"
        android:textSize="@dimen/font_22"
        app:layout_constraintTop_toBottomOf="@id/imageView1" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_20"
        android:text="@string/emergency_contact_name"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edtEmergencyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/emergency_contact_name"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView1" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:text="@string/relationship"
        app:layout_constraintTop_toBottomOf="@id/edtEmergencyName" />

    <TextView
        android:id="@+id/tvRelationship"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/relationship"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView2" />

    <ImageView
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/size_6"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintBottom_toBottomOf="@id/tvRelationship"
        app:layout_constraintEnd_toEndOf="@id/tvRelationship"
        app:layout_constraintTop_toTopOf="@id/tvRelationship" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:text="@string/emergency_phone"
        app:layout_constraintTop_toBottomOf="@id/tvRelationship" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edtEmergencyPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/emergency_phone"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView3" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:text="@string/house_address"
        app:layout_constraintTop_toBottomOf="@id/edtEmergencyPhone" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edtHouseAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/house_address"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:text="@string/commune"
        app:layout_constraintTop_toBottomOf="@id/edtHouseAddress" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edtCommune"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/commune"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView5" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:text="@string/province_city"
        app:layout_constraintTop_toBottomOf="@id/edtCommune" />

    <TextView
        android:id="@+id/tvProvince"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_4"
        android:background="@drawable/bg_circle_stroke_8"
        android:hint="@string/province_city"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_12"
        android:textSize="@dimen/font_16"
        app:layout_constraintTop_toBottomOf="@id/textView6" />

    <ImageView
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/size_6"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintBottom_toBottomOf="@id/tvProvince"
        app:layout_constraintEnd_toEndOf="@id/tvProvince"
        app:layout_constraintTop_toTopOf="@id/tvProvince" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
