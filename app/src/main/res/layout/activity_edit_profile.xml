<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_home_background">

    <View
        android:id="@+id/emptyView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-24dp"
        android:background="@drawable/bg_gradient_green_no_border"
        app:layout_constraintBottom_toBottomOf="@id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/flBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18"
        android:padding="@dimen/size_6"
        app:layout_constraintBottom_toBottomOf="@id/emptyView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:contentDescription="@null"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />
    </FrameLayout>


    <TextView
        android:id="@+id/textView1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_24"
        android:layout_weight="1"
        android:fontFamily="@font/bold"
        android:text="@string/ch_nh_s_a_h_s"
        android:textColor="@color/white"
        android:textSize="@dimen/font_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/flBack"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_12"
        android:layout_marginTop="@dimen/size_8"
        android:fontFamily="@font/regular"
        android:gravity="start"
        android:text="@string/c_p_nh_t_th_ng_tin_c_nh_n"
        android:textColor="@color/grey_93"
        android:textSize="@dimen/font_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/flBack"
        app:layout_constraintTop_toBottomOf="@id/textView1" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emptyView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/size_32">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_18"
                android:layout_marginTop="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_24"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="@dimen/size_128"
                    android:layout_height="@dimen/size_128"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="@null"
                    android:elevation="@dimen/size_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:textColor="@color/grey_46"
                    app:layout_constraintTop_toBottomOf="@id/ivAvatar"
                    tools:text="@string/nh_n_v_o_icon_camera_thay_i_nh" />

                <ImageView
                    android:layout_width="@dimen/size_40"
                    android:layout_height="@dimen/size_40"
                    android:background="@drawable/bg_circle_white_100"
                    android:contentDescription="@null"
                    android:elevation="@dimen/size_22"
                    android:padding="@dimen/size_10"
                    android:src="@drawable/ic_camera"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintEnd_toEndOf="@id/ivAvatar"
                    app:tint="@color/green_36" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_18"
                android:layout_marginTop="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_24"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/constrainLayout1">

                <LinearLayout
                    android:id="@+id/linearLayout1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_profile_selected"
                        app:tint="@color/green_36" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_8"
                        android:fontFamily="@font/bold"
                        android:text="@string/th_ng_tin_c_nh_n"
                        android:textSize="@dimen/font_16" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/h_v_t_n"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout1" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintTop_toBottomOf="@id/textView3"
                    tools:text="Nguyễn Văn A" />


                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/t_n_hi_n_th"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtName" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtShowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintTop_toBottomOf="@id/textView4"
                    tools:text="Văn A" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/ng_y_sinh"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toStartOf="@id/textView6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtShowName" />

                <TextView
                    android:id="@+id/tvBirth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintEnd_toStartOf="@id/tvGender"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView5"
                    tools:text="01/15/1990" />

                <ImageView
                    android:layout_width="@dimen/size_20"
                    android:layout_height="@dimen/size_20"
                    android:layout_marginEnd="@dimen/size_6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:layout_constraintBottom_toBottomOf="@id/tvBirth"
                    app:layout_constraintEnd_toEndOf="@id/tvBirth"
                    app:layout_constraintTop_toTopOf="@id/tvBirth" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/ng_y_sinh"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/textView5"
                    app:layout_constraintTop_toBottomOf="@id/edtShowName" />

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvBirth"
                    app:layout_constraintTop_toBottomOf="@id/textView5"
                    tools:text="01/15/1990" />

                <ImageView
                    android:layout_width="@dimen/size_20"
                    android:layout_height="@dimen/size_20"
                    android:layout_marginEnd="@dimen/size_6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down"
                    app:layout_constraintBottom_toBottomOf="@id/tvGender"
                    app:layout_constraintEnd_toEndOf="@id/tvGender"
                    app:layout_constraintTop_toTopOf="@id/tvGender" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_18"
                android:layout_marginTop="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_24"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/constrainLayout2">

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/azure_53" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_8"
                        android:fontFamily="@font/bold"
                        android:text="@string/th_ng_tin_li_n_h"
                        android:textSize="@dimen/font_16" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/s_i_n_tho_i"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout2" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintEnd_toStartOf="@id/tvChangePhone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView7"
                    tools:text="0868674213" />

                <TextView
                    android:id="@+id/tvChangePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/size_8"
                    android:layout_marginEnd="@dimen/size_4"
                    android:background="@drawable/bg_border_white_6"
                    android:elevation="@dimen/size_4"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/size_16"
                    android:text="@string/thay_i"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintBottom_toBottomOf="@id/edtPhone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/edtPhone"
                    app:layout_constraintTop_toTopOf="@id/edtPhone" />

                <TextView
                    android:id="@+id/tvPhoneVerifyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_2"
                    android:layout_marginTop="@dimen/size_4"
                    android:fontFamily="@font/regular"
                    android:text="@string/x_c_th_c"
                    android:textColor="@color/grey_46"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtPhone" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14"
                    android:fontFamily="@font/bold"
                    android:text="@string/email"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPhoneVerifyState" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintTop_toBottomOf="@id/textView8"
                    tools:text="vana@gmail.com" />


                <TextView
                    android:id="@+id/tvEmailVerifyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_2"
                    android:layout_marginTop="@dimen/size_4"
                    android:fontFamily="@font/regular"
                    android:text="@string/x_c_th_c"
                    android:textColor="@color/grey_46"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtEmail" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_18"
                android:layout_marginTop="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_24"
                app:layout_constraintTop_toBottomOf="@id/constrainLayout3">

                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_vehicle"
                        app:tint="@color/violet_56" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_8"
                        android:fontFamily="@font/bold"
                        android:text="@string/th_ng_tin_ph_ng_ti_n"
                        android:textSize="@dimen/font_16" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:fontFamily="@font/bold"
                    android:text="@string/lo_i_ph_ng_ti_n"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout3" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtVehicleType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintTop_toBottomOf="@id/textView9"
                    tools:text="Grab Bike" />


                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14"
                    android:fontFamily="@font/bold"
                    android:text="@string/bi_n_s_xe"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtVehicleType" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtVehiclePlate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6"
                    android:background="@drawable/bg_circle_stroke_8"
                    android:fontFamily="@font/regular"
                    android:hint="@string/license_plate"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="@dimen/size_8"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintTop_toBottomOf="@id/textView10"
                    tools:text="29A-12345" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
