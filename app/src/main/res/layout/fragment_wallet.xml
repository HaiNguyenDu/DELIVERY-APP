<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_history"
    tools:context=".driver.home.wallet.WalletFragment">

    <View
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-48dp"
        android:background="@drawable/bg_gradient_green_no_border"
        app:layout_constraintBottom_toBottomOf="@id/lineaLayout1"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_24"
        android:layout_marginTop="@dimen/size_20"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="@dimen/size_48"
            android:layout_height="@dimen/size_48"
            android:background="@drawable/bg_border_white_16_20_per"
            android:contentDescription="@null"
            android:padding="@dimen/size_12"
            android:src="@drawable/ic_wallet_selected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_12"
            android:layout_weight="1"
            android:fontFamily="@font/bold"
            android:text="@string/v_c_a_t_i"
            android:textColor="@color/white"
            android:textSize="@dimen/font_22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView1"
            app:layout_constraintTop_toTopOf="@id/imageView1" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_12"
            android:fontFamily="@font/regular"
            android:gravity="start"
            android:text="@string/qu_n_l_thu_nh_p"
            android:textColor="@color/grey_93"
            android:textSize="@dimen/font_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView1"
            app:layout_constraintTop_toBottomOf="@id/textView1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/lineaLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_24"
        android:layout_marginTop="@dimen/size_18"
        android:background="@drawable/bg_border_stroke_white_12_20_per"
        android:orientation="vertical"
        android:padding="@dimen/size_24"
        app:layout_constraintTop_toBottomOf="@id/ctlTopBar">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/regular"
            android:gravity="start"
            android:text="@string/s_d_kh_d_ng"
            android:textColor="#E6FFFFFF"
            android:textSize="@dimen/font_14" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/size_8"
            android:fontFamily="@font/bold"
            android:text="@string/_75_000"
            android:textColor="@color/white"
            android:textSize="@dimen/font_34" />

        <LinearLayout
            android:id="@+id/llWithdrawMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:background="@drawable/bg_border_white_6_90_per"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/size_8">

            <ImageView
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_currency"
                app:tint="@color/green_20" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="@string/r_t_ti_n"
                android:textColor="@color/green_29" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlIncome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_16"
        android:layout_marginTop="@dimen/size_26"
        android:background="@drawable/bg_border_stroke_white_12_95_per"
        android:padding="@dimen/size_16"
        app:layout_constraintEnd_toStartOf="@id/ctlRate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lineaLayout1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            android:text="@string/income"
            android:textSize="@dimen/font_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:background="@drawable/bg_gradient_blue_border_8"
            android:contentDescription="@null"
            android:padding="@dimen/size_10"
            android:src="@drawable/ic_income"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:fontFamily="@font/bold"
            android:text="@string/_3"
            android:textSize="@dimen/font_20"
            app:layout_constraintTop_toBottomOf="@id/imageView3" />

        <TextView
            android:id="@+id/tvOrderCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/regular"
            android:text="@string/t_3_n"
            android:textColor="@color/grey_46"
            android:textSize="@dimen/font_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTotalIncome" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlRate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginTop="@dimen/size_26"
        android:layout_marginEnd="@dimen/size_16"
        android:background="@drawable/bg_border_stroke_white_12_95_per"
        android:padding="@dimen/size_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ctlIncome"
        app:layout_constraintTop_toBottomOf="@id/lineaLayout1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            android:text="@string/nh_gi"
            android:textSize="@dimen/font_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:background="@drawable/bg_gradient_green_border_8"
            android:contentDescription="@null"
            android:padding="@dimen/size_10"
            android:src="@drawable/ic_currency"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAverageIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:fontFamily="@font/bold"
            android:text="@string/_75_000"
            android:textSize="@dimen/font_20"
            app:layout_constraintTop_toBottomOf="@id/imageView4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/regular"
            android:text="@string/thu_nh_p_trung_b_nh"
            android:textColor="@color/grey_46"
            android:textSize="@dimen/font_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAverageIncome" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlWithdrawInform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_18"
        android:background="@drawable/bg_gradient_green_12_10per"
        android:padding="@dimen/size_16"
        app:layout_constraintTop_toBottomOf="@id/ctlIncome">

        <ImageView
            android:id="@id/imageView1"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:contentDescription="@null"
            android:src="@drawable/ic_withdraw"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:fontFamily="@font/bold"
            android:text="@string/th_ng_tin_r_t_ti_n"
            android:textColor="@color/green_20"
            android:textSize="@dimen/font_16"
            app:layout_constraintBottom_toBottomOf="@id/imageView1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView1"
            app:layout_constraintTop_toTopOf="@id/imageView1" />

        <LinearLayout
            android:id="@+id/lineaLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/imageView1">

            <ImageView
                android:layout_width="@dimen/size_6"
                android:layout_height="@dimen/size_6"
                android:contentDescription="@null"
                android:src="@drawable/ic_dot"
                app:tint="@color/green_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6"
                android:layout_weight="1"
                android:fontFamily="@font/regular"
                android:text="@string/s_ti_n_r_t_t_i_thi_u_50_000"
                android:textColor="@color/green_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lineaLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lineaLayout2">

            <ImageView
                android:layout_width="@dimen/size_6"
                android:layout_height="@dimen/size_6"
                android:contentDescription="@null"
                android:src="@drawable/ic_dot"
                app:tint="@color/green_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6"
                android:layout_weight="1"
                android:fontFamily="@font/regular"
                android:text="@string/ph_r_t_ti_n_mi_n_ph"
                android:textColor="@color/green_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lineaLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lineaLayout3">

            <ImageView
                android:layout_width="@dimen/size_6"
                android:layout_height="@dimen/size_6"
                android:contentDescription="@null"
                android:src="@drawable/ic_dot"
                app:tint="@color/green_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6"
                android:layout_weight="1"
                android:fontFamily="@font/regular"
                android:text="@string/th_i_gian_x_l_1_2_ng_y_l_m_vi_c"
                android:textColor="@color/green_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lineaLayout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/lineaLayout4">

            <ImageView
                android:layout_width="@dimen/size_6"
                android:layout_height="@dimen/size_6"
                android:contentDescription="@null"
                android:src="@drawable/ic_dot"
                app:tint="@color/green_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6"
                android:layout_weight="1"
                android:fontFamily="@font/regular"
                android:text="@string/ti_n_s_c_chuy_n_v_t_i_kho_n_ng_n_h_ng_ng_k"
                android:textColor="@color/green_24" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_16"
        android:layout_marginTop="@dimen/size_16"
        android:background="@drawable/bg_border_stroke_white_12_80_per"
        android:minHeight="@dimen/size_300"
        app:layout_constraintTop_toBottomOf="@id/ctlWithdrawInform">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_26"
            android:layout_marginTop="@dimen/size_26"
            android:fontFamily="@font/bold"
            android:text="@string/l_ch_s_giao_d_ch"
            android:textSize="@dimen/font_16"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/emptyLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/size_18"
            android:background="@null"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView4">

            <ImageView
                android:layout_width="@dimen/size_64"
                android:layout_height="@dimen/size_64"
                android:contentDescription="@null"
                android:src="@drawable/ic_wallet_selected"
                app:tint="@color/azure_84" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16"
                android:fontFamily="@font/medium"
                android:text="@string/ch_a_c_giao_d_ch"
                android:textColor="@color/azure_34"
                android:textSize="@dimen/font_16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4"
                android:fontFamily="@font/regular"
                android:text="@string/l_ch_s_r_t_ti_n_s_hi_n_th_t_i_y"
                android:textColor="@color/grey_46"
                android:textSize="@dimen/font_14" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_16"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/textView4" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
