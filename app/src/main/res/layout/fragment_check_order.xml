<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_20"
        android:src="@drawable/ic_back"
        android:background="@color/white"
        android:layout_marginStart="@dimen/size_20"
        app:layout_constraintTop_toTopOf="parent"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        android:layout_marginTop="@dimen/size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="@dimen/size_8">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_20"
                android:fontFamily="@font/bold"
                android:text="Chi tiết đơn hàng"
                android:textSize="@dimen/font_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ic_pick_up_location"
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:src="@drawable/ic_now_location_blue"
                app:layout_constraintBottom_toBottomOf="@+id/tv_pu_address"
                app:layout_constraintStart_toStartOf="@id/tv_title"
                app:layout_constraintTop_toTopOf="@+id/tv_pu_address" />

            <TextView
                android:id="@+id/tv_pu_address"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="Người gửi"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@+id/tv_title" />

            <LinearLayout
                android:id="@+id/layout_pu_info"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_30"
                app:layout_constraintEnd_toEndOf="@+id/tv_pu_address"
                app:layout_constraintStart_toStartOf="@+id/tv_pu_address"
                app:layout_constraintTop_toBottomOf="@+id/tv_pu_address">

                <TextView
                    android:id="@+id/tv_pu_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Nguyễn Duy Hải"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_pu_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="0914103372"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <TextView
                android:id="@+id/pu_detail_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/medium"
                android:maxLines="2"
                android:text="0914103372"
                android:textColor="@color/grey"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="@+id/layout_pu_info"
                app:layout_constraintStart_toStartOf="@+id/layout_pu_info"
                app:layout_constraintTop_toBottomOf="@+id/layout_pu_info" />

            <FrameLayout
                android:id="@+id/line_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/size_20"
                android:layout_marginTop="@dimen/size_10"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@+id/pu_detail_address" />

            <ImageView
                android:id="@+id/ic_drop_off_location"
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:layout_marginStart="@dimen/size_20"
                android:src="@drawable/ic_now_location_red"
                app:layout_constraintBottom_toBottomOf="@+id/tv_dr_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_dr_address" />

            <TextView
                android:id="@+id/tv_dr_address"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="Người gửi"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@+id/line_1" />

            <LinearLayout
                android:id="@+id/layout_dr_info"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_30"
                app:layout_constraintEnd_toEndOf="@+id/tv_dr_address"
                app:layout_constraintStart_toStartOf="@+id/tv_dr_address"
                app:layout_constraintTop_toBottomOf="@+id/tv_dr_address">

                <TextView
                    android:id="@+id/tv_dr_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Nguyễn Duy Hải"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_dr_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="0914103372"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <TextView
                android:id="@+id/dr_detail_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/medium"
                android:maxLines="2"
                android:text="0914103372"
                android:textColor="@color/grey"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="@+id/layout_dr_info"
                app:layout_constraintStart_toStartOf="@+id/layout_dr_info"
                app:layout_constraintTop_toBottomOf="@+id/layout_dr_info" />

            <TextView
                android:id="@+id/tv_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_30"
                android:fontFamily="@font/bold"
                android:text="Lựa chọn giao đơn"
                android:textSize="@dimen/font_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dr_detail_address" />

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:layout_marginStart="@dimen/size_20"
                android:src="@drawable/ic_box_yellow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_type_name" />

            <TextView
                android:id="@+id/tv_type_name"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="Lấy hàng trong vòng 15 phút"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_2" />

            <LinearLayout
                android:id="@+id/layout_type"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_30"
                app:layout_constraintEnd_toEndOf="@+id/tv_type_name"
                app:layout_constraintStart_toStartOf="@+id/tv_type_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_name">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Giao vào 00:22"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_type_ship"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Siêu tốc"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:layout_marginStart="@dimen/size_20"
                android:src="@drawable/ic_delivery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_type_bike" />

            <TextView
                android:id="@+id/tv_type_bike"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="Xe máy"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@+id/layout_type" />

            <TextView
                android:id="@+id/tv_type_bike_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/medium"
                android:maxLines="1"
                android:text="Đề xuất dựa trên chi tiết món hàng "
                android:textColor="@color/grey"
                android:textSize="@dimen/font_14"
                app:layout_constraintStart_toStartOf="@+id/tv_type_bike"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_bike" />

            <ImageView
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:layout_marginStart="@dimen/size_20"
                android:src="@drawable/ic_many_box"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_detail_package" />

            <TextView
                android:id="@+id/tv_detail_package"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="S-5 kg-Thực phẩm"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_bike_message" />

            <LinearLayout
                android:id="@+id/layout_type_package"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_30"
                app:layout_constraintEnd_toEndOf="@+id/tv_type_name"
                app:layout_constraintStart_toStartOf="@+id/tv_type_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_detail_package">

                <TextView
                    android:id="@+id/tv_package"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Giao vào 00:22"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Siêu tốc"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>