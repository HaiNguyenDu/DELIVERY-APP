<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Toolbar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_blue"
        android:navigationIcon="@drawable/ic_back"
        android:title="Chi tiết đơn hàng"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_20"
        android:layout_marginTop="@dimen/size_20"
        app:cardCornerRadius="@dimen/size_20"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/size_20">

            <ImageView
                android:id="@+id/ic_drop_off_location"
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:src="@drawable/ic_now_location_red"
                app:layout_constraintBottom_toBottomOf="@+id/tv_dr_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_dr_address" />

            <ImageView
                android:id="@+id/ic_pick_up_location"
                android:layout_width="@dimen/size_16"
                android:layout_height="@dimen/size_16"
                android:src="@drawable/ic_now_location_blue"
                app:layout_constraintBottom_toBottomOf="@+id/tv_pu_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_pu_address" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:paddingVertical="@dimen/size_10"
                app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                app:layout_constraintEnd_toEndOf="@id/ic_pick_up_location"
                app:layout_constraintStart_toStartOf="@id/ic_pick_up_location"
                app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location">

                <androidx.cardview.widget.CardView
                    android:id="@+id/dot1"
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:cardCornerRadius="@dimen/size_5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/dot2"
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:cardCornerRadius="@dimen/size_5"
                    app:layout_constraintBottom_toTopOf="@id/dot3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dot1"
                    app:layout_constraintVertical_chainStyle="spread" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/dot3"
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:cardCornerRadius="@dimen/size_5"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_pu_address"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="32 Tran Ke Xuong. kt"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layout_pu_info"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/tv_pu_address"
                app:layout_constraintStart_toStartOf="@+id/tv_pu_address"
                app:layout_constraintTop_toBottomOf="@+id/tv_pu_address">

                <TextView
                    android:id="@+id/tv_pu_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Nguyễn Duy Hải"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_pu_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="0914103372"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dr_address"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_20"
                android:layout_marginTop="@dimen/size_20"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="32 Tran Ke Xuong. kt"
                android:textSize="@dimen/font_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ic_drop_off_location"
                app:layout_constraintTop_toBottomOf="@id/layout_pu_info" />

            <LinearLayout
                android:id="@+id/layout_dr_info"
                android:layout_width="@dimen/size_0"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/tv_dr_address"
                app:layout_constraintStart_toStartOf="@+id/tv_dr_address"
                app:layout_constraintTop_toBottomOf="@+id/tv_dr_address">

                <TextView
                    android:id="@+id/tv_dr_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="Nguyễn Duy Hải"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/size_5"
                    android:layout_height="@dimen/size_5"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/size_5"
                    android:backgroundTint="@color/text_color"
                    app:layout_constraintBottom_toTopOf="@id/ic_drop_off_location"
                    app:layout_constraintEnd_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_pick_up_location" />

                <TextView
                    android:id="@+id/tv_dr_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:maxLines="1"
                    android:text="0914103372"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ic_pick_up_location"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>