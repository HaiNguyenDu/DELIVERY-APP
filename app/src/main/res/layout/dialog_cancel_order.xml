<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_24"
    android:paddingBottom="@dimen/size_24">

    <View
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-24dp"
        android:background="@drawable/bg_gradient_orange_top_border"
        app:layout_constraintBottom_toBottomOf="@id/tvOrderId"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_24"
        android:contentDescription="@null"
        android:src="@drawable/ic_note"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvCancelType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:fontFamily="@font/bold"
        android:text="@string/h_y_n"
        android:textColor="@color/white"
        android:textSize="@dimen/font_22"
        app:layout_constraintBottom_toBottomOf="@id/imageView7"
        app:layout_constraintStart_toEndOf="@id/imageView7"
        app:layout_constraintTop_toTopOf="@id/imageView7" />

    <TextView
        android:id="@+id/tvOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_8"
        android:fontFamily="@font/regular"
        android:text="@string/h_nh_ng_n_y_s_nh_h_ng_n_i_m_uy_t_n"
        android:textColor="@color/grey_93"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCancelType" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_16"
        android:fontFamily="@font/bold"
        android:text="@string/ch_n_l_do"
        android:textColor="@color/black"
        android:textSize="@dimen/font_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emptyView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCancelReason"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_300"
        android:layout_marginTop="@dimen/size_12"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/size_24"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        tools:itemCount="3"
        tools:listitem="@layout/item_cancel_reason" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_16"
        android:fontFamily="@font/bold"
        android:text="@string/ghi_ch_th_m"
        android:textColor="@color/black"
        android:textSize="@dimen/font_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvCancelReason" />

    <EditText
        android:id="@+id/edtNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_24"
        android:layout_marginTop="@dimen/size_8"
        android:autofillHints=""
        android:background="@drawable/bg_circle_stroke_8"
        android:fontFamily="@font/regular"
        android:gravity="top"
        android:hint="@string/m_t_chi_ti_t_t_nh_hu_ng"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="@dimen/size_8"
        android:textColor="@color/black"
        android:textColorHint="@color/grey_45"
        android:textSize="@dimen/font_14"
        app:layout_constraintTop_toBottomOf="@id/textView3" />

    <TextView
        android:id="@+id/tvCancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_12"
        android:background="@drawable/bg_stroke_gray_6dp"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:paddingVertical="@dimen/size_8"
        android:text="@string/h_yy"
        android:textColor="@color/black"
        android:textSize="@dimen/font_16"
        app:layout_constraintEnd_toStartOf="@id/tvApply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtNote" />

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginEnd="@dimen/size_24"
        android:background="@drawable/bg_gradient_orange_border_12"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:paddingVertical="@dimen/size_8"
        android:text="@string/x_c_nh_n"
        android:textColor="@color/white"
        android:textSize="@dimen/font_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvCancel"
        app:layout_constraintTop_toBottomOf="@id/edtNote" />
</androidx.constraintlayout.widget.ConstraintLayout>