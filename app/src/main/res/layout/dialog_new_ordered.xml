<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_circle_dialog_24"
    android:paddingBottom="@dimen/size_24">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-32dp"
        android:background="@drawable/bg_gradient_green_top_border"
        app:layout_constraintBottom_toTopOf="@id/ctlSecondCount"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_24"
        android:fontFamily="@font/bold"
        android:text="@string/n_h_ng_m_i"
        android:textColor="@color/white"
        android:textSize="@dimen/font_22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_8"
        android:fontFamily="@font/regular"
        android:text="@string/m_dh001234"
        android:textColor="@color/grey_93"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlSecondCount"
        android:layout_width="@dimen/size_64"
        android:layout_height="@dimen/size_64"
        android:background="@drawable/bg_circle_white_100"
        android:elevation="@dimen/size_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOrderId">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/size_2"
            android:src="@drawable/ic_second_count" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:text="@string/_6s"
            android:textColor="@color/green_36"
            android:textSize="@dimen/font_20" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDeliveryAddress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_200"
        android:overScrollMode="never"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/ctlDistance"
        app:layout_constraintTop_toBottomOf="@id/ctlSecondCount"
        tools:itemCount="3"
        tools:listitem="@layout/item_delivery_address" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieScrollDown"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_40"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvDeliveryAddress"
        app:layout_constraintEnd_toEndOf="@id/rvDeliveryAddress"
        app:layout_constraintStart_toStartOf="@id/rvDeliveryAddress"
        app:lottie_autoPlay="true"
        app:lottie_fileName="anim_scroll_down.json"
        app:lottie_loop="true"
        app:lottie_repeatMode="reverse" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_12"
        android:background="@drawable/bg_gradient_distance_16"
        android:padding="@dimen/size_14"
        app:layout_constraintEnd_toStartOf="@id/ctlTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvDeliveryAddress">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:contentDescription="@null"
            android:src="@drawable/ic_distance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:fontFamily="@font/medium"
            android:text="@string/kho_ng_c_ch"
            android:textColor="@color/green_20"
            app:layout_constraintBottom_toBottomOf="@id/imageView3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView3"
            app:layout_constraintTop_toTopOf="@id/imageView3" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/bold"
            android:text="@string/_3_2_km"
            android:textColor="@color/black"
            android:textSize="@dimen/font_18"
            app:layout_constraintTop_toBottomOf="@id/imageView3" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginEnd="@dimen/size_24"
        android:background="@drawable/bg_gradient_time_16"
        android:padding="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ctlDistance"
        app:layout_constraintTop_toBottomOf="@id/rvDeliveryAddress">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:contentDescription="@null"
            android:src="@drawable/ic_history_selected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/azure_48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:fontFamily="@font/medium"
            android:text="@string/th_i_gian"
            android:textColor="@color/azure_48"
            app:layout_constraintBottom_toBottomOf="@id/imageView4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView4"
            app:layout_constraintTop_toTopOf="@id/imageView4" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/bold"
            android:text="@string/_15_ph_t"
            android:textColor="@color/black"
            android:textSize="@dimen/font_18"
            app:layout_constraintTop_toBottomOf="@id/imageView4" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlIncome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_12"
        android:background="@drawable/bg_gradient_distance_16"
        android:padding="@dimen/size_14"
        app:layout_constraintEnd_toStartOf="@id/ctlCOD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ctlDistance">

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:contentDescription="@null"
            android:src="@drawable/ic_currency"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/green_30" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:fontFamily="@font/medium"
            android:text="@string/income"
            android:textColor="@color/green_24"
            app:layout_constraintBottom_toBottomOf="@id/imageView5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView5"
            app:layout_constraintTop_toTopOf="@id/imageView5" />

        <TextView
            android:id="@+id/tvIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/bold"
            android:text="@string/_75_000"
            android:textColor="@color/green_24"
            android:textSize="@dimen/font_18"
            app:layout_constraintTop_toBottomOf="@id/imageView5" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlCOD"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginEnd="@dimen/size_24"
        android:background="@drawable/bg_gradient_cod_16"
        android:padding="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ctlIncome"
        app:layout_constraintTop_toBottomOf="@id/ctlTime">

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:contentDescription="@null"
            android:src="@drawable/ic_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/orange_48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:fontFamily="@font/medium"
            android:text="@string/cod"
            android:textColor="@color/orange_40"
            app:layout_constraintBottom_toBottomOf="@id/imageView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView6"
            app:layout_constraintTop_toTopOf="@id/imageView6" />

        <TextView
            android:id="@+id/tvCOD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:fontFamily="@font/bold"
            android:text="@string/kh_ng"
            android:textColor="@color/orange_40"
            android:textSize="@dimen/font_18"
            app:layout_constraintTop_toBottomOf="@id/imageView6" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/llNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_24"
        android:layout_marginTop="@dimen/size_16"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ctlIncome">

        <TextView
            android:id="@+id/tvFragileGoods"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_border_stroke_fragile_good_6"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="@dimen/font_12"
            android:paddingVertical="@dimen/size_4"
            android:text="@string/h_ng_d_v"
            android:textColor="@color/orange_29"
            android:textSize="@dimen/font_12" />

        <TextView
            android:id="@+id/tvIsNotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:background="@drawable/bg_border_stroke_is_notion_6"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="@dimen/font_12"
            android:paddingVertical="@dimen/size_4"
            android:text="@string/c_ghi_ch"
            android:textColor="@color/blue_40"
            android:textSize="@dimen/font_12" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSkipOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24"
        android:layout_marginTop="@dimen/size_24"
        android:background="@drawable/bg_border_stroke_skip_6"
        android:fontFamily="@font/bold"
        android:gravity="center"
        android:paddingVertical="@dimen/size_16"
        android:text="@string/b_qua"
        android:textColor="@color/black"
        android:textSize="@dimen/font_16"
        app:layout_constraintEnd_toStartOf="@id/tvAcceptOrder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llNote" />

    <TextView
        android:id="@+id/tvAcceptOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginTop="@dimen/size_24"
        android:layout_marginEnd="@dimen/size_24"
        android:background="@drawable/bg_border_green_6"
        android:fontFamily="@font/bold"
        android:gravity="center"
        android:paddingVertical="@dimen/size_16"
        android:text="@string/nh_n_n"
        android:textColor="@color/white"
        android:textSize="@dimen/font_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvSkipOrder"
        app:layout_constraintTop_toBottomOf="@id/llNote" />


</androidx.constraintlayout.widget.ConstraintLayout>