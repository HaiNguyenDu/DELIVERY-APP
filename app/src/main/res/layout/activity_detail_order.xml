                        android:text="@string/h_ng_d_v_c_n_th_n_khi_v_n_chuy_n"
                        android:textColor="@color/orange_29"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>

                <View
                    android:id="@+id/emptyView1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_1"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@color/azure_84"
                    app:layout_constraintTop_toBottomOf="@id/llOrderNote" />

                <TextView
                    android:id="@+id/textView8"
