<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_history"
    tools:context=".driver.order_detail.OrderDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_36"
            android:layout_marginVertical="@dimen/size_22"
            android:layout_marginStart="@dimen/size_16"
            android:contentDescription="@null"
            android:padding="@dimen/size_8"
            android:src="@drawable/ic_line_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_12"
            android:layout_marginTop="@dimen/size_16"
            android:fontFamily="@font/bold"
            android:text="@string/chi_ti_t_n_h_ng"
            android:textSize="@dimen/font_18"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/regular"
            android:text="@string/dh001234"
            android:textColor="@color/azure_34"
            android:textSize="@dimen/font_14"
            app:layout_constraintStart_toStartOf="@id/textView1"
            app:layout_constraintTop_toBottomOf="@id/textView1" />

        <LinearLayout
            android:id="@+id/llLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8"
            android:layout_marginTop="@dimen/size_20"
            android:background="@drawable/bg_border_stroke_green_100_10_per"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/size_10"
            android:paddingVertical="@dimen/size_4"
            app:layout_constraintStart_toEndOf="@id/textView1"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/size_12"
                android:layout_height="@dimen/size_12"
                android:contentDescription="@null"
                android:src="@drawable/ic_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6"
                android:fontFamily="@font/medium"
                android:text="@string/live"
                android:textColor="@color/green_29"
                android:textSize="@dimen/font_10" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_16"
            android:background="@drawable/bg_border_stroke_light_green_6_20_per"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="@dimen/size_12"
            android:paddingVertical="@dimen/size_4"
            android:text="@string/received_order"
            android:textColor="@color/green_24"
            android:textSize="@dimen/font_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llLive" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_8"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/tvDeliveryComplete"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivMap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_300"
                android:layout_marginHorizontal="@dimen/size_16"
                android:layout_marginTop="@dimen/size_16"
                android:background="@color/black"
                android:contentDescription="@null"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctlOrderProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16"
                android:layout_marginTop="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_16"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/ivMap">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="@string/ti_n_tr_nh_n_h_ng"
                    android:textColor="@color/azure_27"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/linearLayout1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@null"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/textView2">

                    <ImageView
                        android:id="@+id/ivReceivedOrder"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:background="@drawable/bg_gradient_finding_orders_100"
                        android:contentDescription="@null"
                        android:padding="@dimen/size_8"
                        android:src="@drawable/ic_white_tick" />

                    <TextView
                        android:id="@+id/tvReceivedOrder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_12"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/received_order"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:id="@+id/ivReceivedOrderStatus"
                        android:layout_width="@dimen/size_8"
                        android:layout_height="@dimen/size_8"
                        android:background="@drawable/bg_gradient_finding_orders_100"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@null"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout1">

                    <ImageView
                        android:id="@+id/ivComingTo"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_not_in_progress" />

                    <TextView
                        android:id="@+id/tvComingTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_12"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/ang_n_l_y_h_ng"
                        android:textColor="@color/grey_46"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:id="@+id/ivComingToStatus"
                        android:layout_width="@dimen/size_8"
                        android:layout_height="@dimen/size_8"
                        android:background="@drawable/bg_gradient_orange_100"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@null"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout2">

                    <ImageView
                        android:id="@+id/ivReceivedGood"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_not_in_progress" />

                    <TextView
                        android:id="@+id/tvReceivedGood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_12"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/received_goods"
                        android:textColor="@color/grey_46"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:id="@+id/ivReceivedGoodStatus"
                        android:layout_width="@dimen/size_8"
                        android:layout_height="@dimen/size_8"
                        android:background="@drawable/bg_gradient_purple_100"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayout4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@null"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout3">

                    <ImageView
                        android:id="@+id/ivDelivering"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_not_in_progress" />

                    <TextView
                        android:id="@+id/tvDelivering"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_12"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/ang_giao_h_ng"
                        android:textColor="@color/grey_46"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:id="@+id/ivDeliveringStatus"
                        android:layout_width="@dimen/size_8"
                        android:layout_height="@dimen/size_8"
                        android:background="@drawable/bg_gradient_red_100"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayout5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@null"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout4">

                    <ImageView
                        android:id="@+id/ivDelivered"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_not_in_progress" />

                    <TextView
                        android:id="@+id/tvDelivered"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_12"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/delivered"
                        android:textColor="@color/grey_46"
                        android:textSize="@dimen/font_14" />

                    <ImageView
                        android:id="@+id/ivDeliveredStatus"
                        android:layout_width="@dimen/size_8"
                        android:layout_height="@dimen/size_8"
                        android:background="@drawable/bg_gradient_green_100"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctlPickUpAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_16"
                app:layout_constraintTop_toBottomOf="@id/ctlOrderProgress">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="@dimen/size_40"
                    android:layout_height="@dimen/size_40"
                    android:background="@drawable/bg_gradient_finding_orders_100"
                    android:contentDescription="@null"
                    android:padding="@dimen/size_10"
                    android:src="@drawable/ic_address"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/font_12"
                    android:fontFamily="@font/medium"
                    android:text="@string/i_m_l_y_h_ng"
                    android:textColor="@color/grey_46"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintStart_toEndOf="@id/imageView1"
                    app:layout_constraintTop_toTopOf="@id/imageView1" />

                <TextView
                    android:id="@+id/tvPickUpName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:layout_marginEnd="@dimen/size_24"
                    android:fontFamily="@font/bold"
                    android:text="@string/nguy_n_v_n_a"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/textView3"
                    app:layout_constraintTop_toBottomOf="@id/textView3" />

                <TextView
                    android:id="@+id/tvPickUpAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/size_24"
                    android:fontFamily="@font/regular"
                    android:text="@string/_123_ng_l_l_i_qu_n_1_tp_hcm"
                    android:textColor="@color/azure_34"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvPickUpName"
                    app:layout_constraintTop_toBottomOf="@id/tvPickUpName" />

                <TextView
                    android:id="@+id/tvCallInAdvance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:background="@drawable/bg_border_stroke_yellow_8_10_per"
                    android:fontFamily="@font/regular"
                    android:padding="@dimen/size_8"
                    android:text="@string/g_i_tr_c_10_ph_t"
                    android:textColor="@color/orange_29"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvPickUpAddress"
                    app:layout_constraintTop_toBottomOf="@id/tvPickUpAddress" />

                <LinearLayout
                    android:id="@+id/llCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@drawable/bg_border_stroke_white_6_50_per"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/size_8"
                    app:layout_constraintEnd_toStartOf="@id/llMess"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCallInAdvance">

                    <ImageView
                        android:layout_width="@dimen/size_16"
                        android:layout_height="@dimen/size_16"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_16"
                        android:fontFamily="@font/medium"
                        android:text="@string/g_i"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMess"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_8"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@drawable/bg_border_stroke_white_6_50_per"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/size_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/llCall"
                    app:layout_constraintTop_toBottomOf="@id/tvCallInAdvance">

                    <ImageView
                        android:layout_width="@dimen/size_16"
                        android:layout_height="@dimen/size_16"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mess"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_16"
                        android:fontFamily="@font/medium"
                        android:text="@string/nh_n_tin"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctlDeliverAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_16"
                android:background="@drawable/bg_gradient_pink_5per"
                android:padding="@dimen/size_16"
                app:layout_constraintTop_toBottomOf="@id/ctlPickUpAddress">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="@dimen/size_40"
                    android:layout_height="@dimen/size_40"
                    android:background="@drawable/bg_gradient_dark_red_100"
                    android:contentDescription="@null"
                    android:padding="@dimen/size_10"
                    android:src="@drawable/ic_address"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/font_12"
                    android:fontFamily="@font/medium"
                    android:text="@string/i_m_l_y_h_ng"
                    android:textColor="@color/grey_46"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintStart_toEndOf="@id/imageView2"
                    app:layout_constraintTop_toTopOf="@id/imageView2" />

                <TextView
                    android:id="@+id/tvReceiverName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:layout_marginEnd="@dimen/size_24"
                    android:fontFamily="@font/bold"
                    android:text="@string/nguy_n_v_n_a"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/textView4"
                    app:layout_constraintTop_toBottomOf="@id/textView4" />

                <TextView
                    android:id="@+id/tvReceiverAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/size_24"
                    android:fontFamily="@font/regular"
                    android:text="@string/_123_ng_l_l_i_qu_n_1_tp_hcm"
                    android:textColor="@color/azure_34"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvReceiverName"
                    app:layout_constraintTop_toBottomOf="@id/tvReceiverName" />

                <TextView
                    android:id="@+id/tvCallReceiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:background="@drawable/bg_border_stroke_blue_8_10_per"
                    android:fontFamily="@font/regular"
                    android:padding="@dimen/size_8"
                    android:text="@string/giao_gi_h_nh_ch_nh"
                    android:textColor="@color/blue_40"
                    android:textSize="@dimen/font_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvReceiverAddress"
                    app:layout_constraintTop_toBottomOf="@id/tvReceiverAddress" />

                <LinearLayout
                    android:id="@+id/llCallReceiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@drawable/bg_border_stroke_white_6_50_per"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/size_8"
                    app:layout_constraintEnd_toStartOf="@id/llMessReceiver"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCallReceiver">

                    <ImageView
                        android:layout_width="@dimen/size_16"
                        android:layout_height="@dimen/size_16"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_16"
                        android:fontFamily="@font/medium"
                        android:text="@string/g_i"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMessReceiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_8"
                    android:layout_marginTop="@dimen/size_12"
                    android:background="@drawable/bg_border_stroke_white_6_50_per"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/size_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/llCallReceiver"
                    app:layout_constraintTop_toBottomOf="@id/tvCallReceiver">

                    <ImageView
                        android:layout_width="@dimen/size_16"
                        android:layout_height="@dimen/size_16"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mess"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_16"
                        android:fontFamily="@font/medium"
                        android:text="@string/nh_n_tin"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constrainLayout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_16"
                android:background="@drawable/bg_border_stroke_white_12_80_per"
                android:padding="@dimen/size_16"
                app:layout_constraintTop_toBottomOf="@id/ctlDeliverAddress">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="@dimen/size_20"
                    android:layout_height="@dimen/size_20"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_box"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/black"
                    tools:ignore="ExtraText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_8"
                    android:fontFamily="@font/bold"
                    android:text="@string/th_ng_tin_n_h_ng"
                    android:textSize="@dimen/font_16"
                    app:layout_constraintStart_toEndOf="@id/imageView3"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12"
                    android:fontFamily="@font/regular"
                    android:text="@string/m_t_h_ng"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageView3" />

                <TextView
                    android:id="@+id/tvGoodsDes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="end"
                    android:text="@string/n_th_c_u_ng"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/textView5"
                    app:layout_constraintTop_toTopOf="@id/textView5" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_8"
                    android:fontFamily="@font/regular"
                    android:text="@string/kh_i_l_ng"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView5" />

                <TextView
                    android:id="@+id/tvGoodsWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="end"
                    android:text="@string/_2_5_kg"
                    android:textSize="@dimen/font_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/textView6"
